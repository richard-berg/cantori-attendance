{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Python Functions",
      "type": "python",
      "request": "attach",
      "port": 9091,
      "preLaunchTask": "func: host start",
      "justMyCode": false
    },
    {
      "name": "Preview attendance report",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/preview_report.py",
      "args": ["attendance_report"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
